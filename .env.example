# Public values only: this site never contains a secret key (they are baked into the page at build time).
# Same Supabase project as the Kasho Pay app and backend.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The publishable (anon) key, never the service role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL of the Kasho Pay backend (kasho-pay-backend)
VITE_API_URL=http://localhost:4000
