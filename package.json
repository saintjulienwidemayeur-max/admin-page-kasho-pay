{
  "name": "admin-page-kasho-pay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kasho Pay admin platform: a separate site (own login with 2FA) to manage fees, customers, Freda balances and profit.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
