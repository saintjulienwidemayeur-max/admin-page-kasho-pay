// Cloudflare Workers static assets: `npm run deploy` builds the site and publishes dist/ (single-page app).
// The security headers are in public/_headers (copied to dist/_headers by the build).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kasho-pay-admin",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
